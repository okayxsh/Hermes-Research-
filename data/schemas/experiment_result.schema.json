{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "run_key",
    "attempt_id",
    "attempt_index",
    "phase",
    "status",
    "task_id",
    "task_index",
    "condition",
    "seed",
    "library_size",
    "success",
    "retrieved_skill_ids",
    "retrieval_similarity_scores",
    "actions",
    "steps",
    "invalid_actions",
    "runtime_seconds",
    "errors",
    "timestamp"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt_id": {"type": "string"},
    "attempt_index": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["acquisition", "evaluation", "checkpoint_test"]},
    "status": {"enum": ["completed", "failed"]},
    "seed": {"type": ["integer", "null"]},
    "library_size": {"type": ["integer", "null"], "minimum": 0},
    "success": {"type": ["boolean", "null"]},
    "recovery_success": {"type": ["boolean", "null"]},
    "retrieved_skill_ids": {"type": "array", "items": {"type": "string"}},
    "retrieval_similarity_scores": {"type": "array", "items": {"type": "number"}},
    "actions": {"type": ["integer", "null"], "minimum": 0},
    "steps": {"type": ["integer", "null"], "minimum": 0},
    "invalid_actions": {"type": ["integer", "null"], "minimum": 0},
    "runtime_seconds": {"type": ["number", "null"], "minimum": 0},
    "errors": {"type": ["array", "null"]},
    "supersedes_attempt_id": {"type": "string"},
    "retry_reason": {"const": "retry_failed"}
  }
}
